{
  "manifest_version": 3,
  "name": "Rakuten Securities 2FA Automation",
  "version": "1.0.0",
  "description": "Automates the image-based 2FA process for Rakuten Securities",
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "notifications"
  ],
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "host_permissions": [
    "https://*.rakuten-sec.co.jp/*"
  ],
  "action": {
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.rakuten-sec.co.jp/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}